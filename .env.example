# ─────────────────────────────────────────────────────────────
# Kvittel Global — environment variables
# Copy to apps/web/.env.local (dev) or set in your host's secret store.
# NEVER commit real values. In development, missing secrets are generated
# once into .data/dev-secrets.json (git-ignored). In production they are required.
# ─────────────────────────────────────────────────────────────

# Public base URL (used in emails, webhooks, sitemap)
APP_URL=http://localhost:3000

# Database. Empty → embedded PGlite in .data/pglite (single process, dev only).
# Production: a managed PostgreSQL 15+ instance.
DATABASE_URL=
DB_POOL_MAX=10
KVITTEL_AUTO_MIGRATE=1

# DEMO mode: mock payments, dev mailbox, device lab, quick demo sign-in, DEMO banners.
# Must be 0 in any real deployment.
KVITTEL_DEMO_MODE=1

# Secrets (base64, 32 random bytes each: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
KVITTEL_ENCRYPTION_KEY=          # AES-256-GCM key for kvittel content & uploads
SESSION_SECRET=
PAYMENT_WEBHOOK_SECRET=          # mock provider webhook HMAC
DEVICE_COMMAND_SECRET=           # derives per-device command signing keys
TRACKING_TOKEN_SECRET=

# Payments: mock | stripe   (stripe adapter is implemented but untested until credentials exist)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: devmailbox | smtp | resend   (only devmailbox is implemented; others fail closed)
MAIL_PROVIDER=devmailbox

# Additional UI languages, enabled only after native QA (yi,es,pt,de)
NEXT_PUBLIC_EXTRA_LOCALES=

# Privacy: days after delivery before kvittel content is purged
KVITTEL_RETENTION_DAYS=30

# Background worker: run in-process (dev / single instance). Set 0 on web nodes when a separate worker runs.
KVITTEL_INPROCESS_WORKER=1
KVITTEL_WORKER_INTERVAL_MS=30000

# Print fonts directory override (defaults to packages/print-layout/fonts)
KVITTEL_FONTS_DIR=

# TEST ONLY — ignore Shabbat/hours windows in E2E runs. Honoured only when KVITTEL_DEMO_MODE=1.
KVITTEL_E2E_IGNORE_SCHEDULE=
